<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Banco Online</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/banking-theme.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-bank">
        <div class="container">
            <a class="navbar-brand" href="/CreditCard">
                <i class="fas fa-university me-2"></i>Mi Banco Online
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav ms-auto align-items-center">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("Token")))
                    {
                        <span class="navbar-text text-white me-3">
                            <i class="fas fa-user-circle me-1"></i>@Context.Session.GetString("UserEmail")
                        </span>
                        <a class="nav-link text-white" href="/Account/Logout">
                            <i class="fas fa-sign-out-alt me-1"></i>Cerrar sesion
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer-bank mt-auto">
        <div class="container text-center">
            <span>&copy; 2026 Mi Banco Online - Todos los derechos reservados</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
